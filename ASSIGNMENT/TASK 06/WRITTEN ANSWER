### E. Compare Text and std::string for 100,000 Concatenations

Use this as a separate timing program:

```cpp
#include <iostream>
#include <string>
#include <chrono>
#include <cstring>
using namespace std;
using namespace chrono;

class Text {
    char* data;

public:
    Text(const char* s = "") {
        data = new char[strlen(s) + 1];
        strcpy(data, s);
    }

    Text(const Text& t) {
        data = new char[strlen(t.data) + 1];
        strcpy(data, t.data);
    }

    Text& operator=(const Text& t) {
        if (this != &t) {
            char* temp = new char[strlen(t.data) + 1];
            strcpy(temp, t.data);
            delete[] data;
            data = temp;
        }
        return *this;
    }

    Text operator+(const Text& t) const {
        int len = strlen(data) + strlen(t.data);
        char* temp = new char[len + 1];

        strcpy(temp, data);
        strcat(temp, t.data);

        Text result(temp);
        delete[] temp;
        return result;
    }

    ~Text() {
        delete[] data;
    }
};

int main() {
    const int n = 100000;

    Text a("A"), b("B");
    string x = "A", y = "B";

    auto start1 = high_resolution_clock::now();

    for (int i = 0; i < n; i++)
        a = a + b;

    auto end1 = high_resolution_clock::now();

    auto start2 = high_resolution_clock::now();

    for (int i = 0; i < n; i++)
        x = x + y;

    auto end2 = high_resolution_clock::now();

    cout << "Text time: "
         << duration_cast<milliseconds>(end1 - start1).count()
         << " ms" << endl;

    cout << "String time: "
         << duration_cast<milliseconds>(end2 - start2).count()
         << " ms" << endl;

    return 0;
}
```

**Observation:**

- Both programs perform 100,000 concatenations.
- `std::string` is generally more efficient because it manages memory internally.
- Record the actual execution times from your compiler.

