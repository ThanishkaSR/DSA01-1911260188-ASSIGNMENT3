### B. Measure Prefix and Postfix Increment

Use this separate program to measure 10,000,000 increments.

```cpp
#include <iostream>
#include <chrono>
using namespace std;
using namespace chrono;

class Counter {
    long long value;

public:
    Counter() : value(0) {}

    Counter& operator++() {
        ++value;
        return *this;
    }

    Counter operator++(int) {
        Counter old = *this;
        ++value;
        return old;
    }

    long long get() const {
        return value;
    }
};

int main() {
    const int n = 10000000;

    Counter a, b;

    auto start1 = high_resolution_clock::now();

    for (int i = 0; i < n; i++)
        ++a;

    auto end1 = high_resolution_clock::now();

    auto start2 = high_resolution_clock::now();

    for (int i = 0; i < n; i++)
        b++;

    auto end2 = high_resolution_clock::now();

    cout << "Prefix time: "
         << duration_cast<microseconds>(end1 - start1).count()
         << " microseconds" << endl;

    cout << "Postfix time: "
         << duration_cast<microseconds>(end2 - start2).count()
         << " microseconds" << endl;

    cout << "Prefix value: " << a.get() << endl;
    cout << "Postfix value: " << b.get() << endl;

    return 0;
}
```

